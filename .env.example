# Copie este arquivo para ".env" e preencha com seus dados reais.

# Porta em que o servidor vai rodar
PORT=3000

# Chave usada para assinar os tokens de login (JWT). Troque por um valor aleatório e secreto.
JWT_SECRET=troque-por-uma-string-aleatoria-bem-grande

# Access Token do Mercado Pago (Produção). Pegue em:
# https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL pública do backend depois de publicado (ex: Railway, Render).
# É para onde o Mercado Pago vai enviar as notificações de pagamento (webhook).
PUBLIC_BACKEND_URL=https://seu-backend.exemplo.com

# URL pública do site/painel do revendedor, para redirecionar após o pagamento
FRONTEND_URL=https://seusite.exemplo.com

# Senha do painel de administrador (fornecedor)
ADMIN_EMAIL=admin@nextap.com.br
ADMIN_PASSWORD=troque-esta-senha

# (Opcional) Caminho do arquivo do banco SQLite. No Railway, crie um Volume e o caminho
# é detectado sozinho (RAILWAY_VOLUME_MOUNT_PATH). Sem Volume, os dados somem a cada deploy.
# DB_PATH=/data/nextap.db

# Onde fica o banco: com Volume conectado no Railway isso é automático (não precisa definir).
# Só defina DB_PATH se quiser outro caminho, por exemplo: DB_PATH=/data/nextap.db

# (Opcional) Envio do e-mail de "esqueci a senha" via Resend (resend.com). Sem isso, o link aparece nos logs do Railway
# e o fornecedor pode gerar o link no painel admin (Revendedores → 🔑) e enviar pelo WhatsApp.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=NexTap <no-reply@seudominio.com.br>

# ---- Domínio próprio ----
# Endereço principal do site (o que aparece na barra do navegador). Quem entrar por outro endereço é redirecionado.
# SITE_HOST=www.nextapbrasil.com.br
# Também use o mesmo endereço aqui (vai nos avisos do Mercado Pago e nos links de senha):
# PUBLIC_BACKEND_URL=https://www.nextapbrasil.com.br

# Prazo de produção mostrado ao revendedor, em dias úteis (padrão: 5).
# PRAZO_PRODUCAO_DIAS=5

# (Opcional) Analista financeiro com IA no Financeiro → Lucro estimado. Crie a chave em console.anthropic.com
# (é uma conta de API, separada do claude.ai). Só números agregados são enviados, nunca dados de clientes.
# ANTHROPIC_API_KEY=sk-ant-...
# ANALISTA_MODELO=claude-sonnet-5-5
