# Senha do painel (obrigatória, mínimo 8 caracteres — use uma longa e única)
ADMIN_PASSWORD=troque-por-uma-senha-longa

# Link que as respostas usam em {{site}}
SITE_URL=https://www.nextapbrasil.com.br

# ---- Instagram (veja SETUP-INSTAGRAM.md) ----
# Texto qualquer e secreto que você inventa; o mesmo valor vai no campo "Verify token" do webhook na Meta
META_VERIFY_TOKEN=invente-um-texto-secreto
# App Secret do app Meta (Configurações do app → Básico). Usado para conferir a assinatura dos eventos.
META_APP_SECRET=
# Token de acesso do Instagram gerado no app Meta (vale ~60 dias; renove no painel → Configurações)
IG_ACCESS_TOKEN=
# (Opcional) ID numérico da conta do Instagram, se o envio por "me" for recusado
# IG_USER_ID=

# Railway: crie um Volume montado em /data e conecte a este serviço (o caminho é detectado sozinho).

# --- Funil v2 (opcionais) ---
# Endereço público do robô, para rastrear o clique na calculadora (no Railway é detectado sozinho)
# PUBLIC_URL=https://seu-servico.up.railway.app
# Aviso no Telegram quando um lead pedir atendimento (prioridade alta)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Prospecção (busca de empresas no Google) ---
# Chave do Google Cloud com "Places API (New)" ativada. Sem ela, a aba Prospecção só aceita cadastro manual.
GOOGLE_PLACES_API_KEY=

# --- WhatsApp (Evolution API: conexão por QR Code) ---
# Endereço do serviço da Evolution API e a chave dele (AUTHENTICATION_API_KEY da Evolution). Guia: SETUP-WHATSAPP.md
EVOLUTION_URL=
EVOLUTION_API_KEY=
# Nome da instância (o "celular" conectado). Padrão: nextap
# EVOLUTION_INSTANCE=nextap

# --- Integração com o site NexTap ---
# Preços por faixa: lidos sozinhos de <SITE_URL>/api/public/price-tiers (troque o endereço só se a API estiver em outro lugar)
# NEXTAP_API_BASE=
# Avisos de cadastro/pedido/pagamento vindos do NexTap (o mesmo valor no serviço do NexTap, mínimo 16 caracteres)
NEXTAP_WEBHOOK_SECRET=
